# GEMINI_API_KEY / GEMNI_API_KEY: Required for Gemini AI API calls and Nano Banana image generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMNI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GEMNI_API_KEY=

# DEEPSEEK_API_KEY: Used for coding generation, code fixing, and workspace AI edits
DEEPSEEK_API_KEY=

# OPENAI_API_KEY: Used for ChatGPT and DALL-E image generation
OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
